# All optional. The deterministic audit needs none of these.

# Persistence. Without it the API uses an in-memory store that dies on restart.
DATABASE_URL=postgresql://user:pass@host/db

# Engine keys for the live visibility scan. At least one is required to run it.
# ANTHROPIC_API_KEY also powers prompt generation; without it, templated prompts are used.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CORS_ORIGINS=http://localhost:3000
